{
  "name": "chamameg-service-worker",
  "version": "1.0.0",
  "main": "index.js",
  "author": "William Lodea Magnabosco",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "worker": "nodemon --exec tsx watch src/worker",
    "job-builder": "tsx watch src/jobBuilder.ts",
    "build": "tsc",
    "start": "node -r dotenv/config ./dist/worker.js",
    "db:generate": "yarn prisma generate",
    "db:seed": "yarn prisma db seed",
    "db:migrate:dev": "yarn prisma migrate dev --name",
    "db:migrate:deploy": "yarn prisma migrate deploy",
    "db:view": "yarn prisma-cli studio"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^7.0.2",
    "nodemon": "^3.1.11",
    "prisma": "7",
    "sucrase": "^3.35.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "7",
    "axios": "^1.13.5",
    "axios-retry": "^4.5.0",
    "bullmq": "^5.68.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.4",
    "nodemailer": "^8.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  }
}
